{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/generation-gate.mjs",
        "matcher": "Write|tests[/\\\\]",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/block-weakened-assertions.mjs",
        "matcher": "tests[/\\\\]",
        "failClosed": true
      }
    ]
  }
}
