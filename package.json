{
  "name": "yelena-ai-testing-course",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug=inspector",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:e2e": "playwright test --grep @e2e",
    "test:destructive": "playwright test --grep @destructive --workers=1",
    "test:manual:didaxis-cleanup": "playwright test --config=playwright.manual.config.ts",
    "test:report": "playwright show-report",
    "eval:report": "node scripts/generate-eval-report.mjs --n 10",
    "codegen": "playwright codegen"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "dotenv": "^18.0.4",
    "typescript": "^7.0.2"
  }
}
