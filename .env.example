# Copy to `.env` and fill in real values. Never commit `.env`.
# Placeholder values only — no real secrets in this file.

# =============================================================================
# Run tests (required to clone and run Playwright)
# =============================================================================

# Base URL of the Didaxis environment under test (no trailing slash).
DIDAXIS_URL=https://test.didaxis.studio

# Primary account used by auth setup / storageState login.
DIDAXIS_EMAIL=your-didaxis-email@example.com

# Password for DIDAXIS_EMAIL.
DIDAXIS_PASSWORD=your-didaxis-password

# Short-lived JWT access_token from POST {DIDAXIS_URL}/api/auth/login (no "Bearer " prefix).
# Used for API cleanup; refresh when expired (~15 minutes).
DIDAXIS_API_TOKEN=your-didaxis-jwt-access-token

# Optional: second account for permission / role probes (not required for the default suite).
DIDAXIS_ALT_EMAIL=your-alt-didaxis-email@example.com
DIDAXIS_ALT_PASSWORD=your-alt-didaxis-password

# =============================================================================
# Agent / CI setup (not needed for `npx playwright test` alone)
# =============================================================================

# Cursor API key for headless `agent` in .github/workflows/test-generation.yml
# (GitHub secret name may be CURSOR_API_TOKEN; the workflow maps it to CURSOR_API_KEY).
CURSOR_API_KEY=your-cursor-api-key

# Atlassian API token for Jira MCP / agent backlog and bug filing.
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Atlassian Cloud site URL (e.g. https://your-org.atlassian.net).
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN.
ATLASSIAN_EMAIL=your-atlassian-email@example.com

# Note: local MCP tokens belong in Cursor settings / `.cursor/mcp.json` (gitignored),
# not in committed files. CI injects the vars above as GitHub Actions secrets.
