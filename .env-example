# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# Didaxis (test environment)
DIDAXIS_URL=https://test.didaxis.studio
DIDAXIS_EMAIL=your-didaxis-email@example.com
DIDAXIS_PASSWORD=your-didaxis-password

# Additional Didaxis accounts — each configured user gets a chromium-user-N project (USER_1 may use DIDAXIS_EMAIL / DIDAXIS_PASSWORD)
DIDAXIS_USER_1_EMAIL=your-didaxis-user-1@example.com
DIDAXIS_USER_1_PASSWORD=your-didaxis-user-1-password
DIDAXIS_USER_2_EMAIL=your-didaxis-user-2@example.com
DIDAXIS_USER_2_PASSWORD=your-didaxis-user-2-password
DIDAXIS_USER_3_EMAIL=your-didaxis-user-3@example.com
DIDAXIS_USER_3_PASSWORD=your-didaxis-user-3-password
# Optional: JWT access_token from POST {DIDAXIS_URL}/api/auth/login — use as Authorization: Bearer <token>
DIDAXIS_API_TOKEN=

# Application under test
BASE_URL=https://demo.playwright.dev/todomvc/

# Test user credentials (for apps that require login)
TEST_USER_EMAIL=your-test-user@example.com
TEST_USER_PASSWORD=your-test-password

# API / integration (if tests call backend services)
API_BASE_URL=https://api.example.com
API_KEY=your-api-key-here

# Optional overrides (CI sets these automatically in pipelines)
# CI=true
