# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# Didaxis (test environment)
DIDAXIS_URL=https://test.didaxis.studio
DIDAXIS_EMAIL=your-didaxis-email@example.com
DIDAXIS_PASSWORD=your-didaxis-password

# Application under test
BASE_URL=https://demo.playwright.dev/todomvc/

# Test user credentials (for apps that require login)
TEST_USER_EMAIL=your-test-user@example.com
TEST_USER_PASSWORD=your-test-password

# API / integration (if tests call backend services)
API_BASE_URL=https://api.example.com
API_KEY=your-api-key-here

# Optional overrides (CI sets these automatically in pipelines)
# CI=true
